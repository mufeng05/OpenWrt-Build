# 源码仓库（GitHub owner/repo）与分支/标签
OPENWRT_REPO=openwrt/openwrt
OPENWRT_REF=main

# EasyTier 的版本：luci-app-easytier 按 EASYTIER_VERSION 环境变量下载对应版本的程序，
# 不设置时用它自带的默认版本（常常落后于上游），这里每次构建都取 EasyTier 版本号最高的 release
# （EasyTier 几乎每个版本都标成 pre-release，所以 pre-release 也算在内）
EASYTIER_VERSION=$(bash scripts/latest-release.sh EasyTier/EasyTier)
