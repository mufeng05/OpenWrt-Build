# 源码仓库（GitHub owner/repo）与分支/标签
OPENWRT_REPO=openwrt/openwrt
OPENWRT_REF=main

# 构建前额外安装的主机 .deb 包（仅在 CI 中安装，多个用空格分隔）。
# Turbo ACC 的 libnftnl 补丁会改动 Makefile.am，触发调用 automake-1.17，而 Ubuntu 24.04 只带 1.16。
HOST_DEBS=https://archive.ubuntu.com/ubuntu/pool/main/a/automake-1.17/automake_1.17-4ubuntu1_all.deb
